{
  "expo": {
    "name": "Boongo",
    "slug": "boongo_app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.reborn.boongo",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Autorisez Boongo à accéder à vos photos pour mettre à jour votre avatar."
      }
    },
    "android": {
      "package": "com.boongo_app_2"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Boongo à accéder à vos photos pour mettre à jour votre avatar."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#242400",
          "image": "./assets/img/brand-with-name.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
