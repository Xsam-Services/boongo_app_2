{
  "expo": {
    "name": "Boongo",
    "slug": "boongo_app",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.reborn.boongo",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Autorisez Boongo à accéder à vos photos pour mettre à jour votre avatar."
      }
    },
    "android": {
      "package": "com.boongo_app_2",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Boongo à accéder à vos photos pour mettre à jour votre avatar."
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#242400",
          "image": "./assets/img/brand-with-name.png",
          "imageWidth": 200
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "bc9f3998-8c3b-4f2d-9730-d00e20e7b2ed"
      }
    },
    "owner": "vander.codes"
  }
}
